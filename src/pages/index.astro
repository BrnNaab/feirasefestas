---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Buscar eventos aprovados ordenados por destaque e data de início
const { data: eventos, error } = await supabase
  .from('eventos')
  .select('*')
  .eq('status', 'aprovado')
  .order('destaque', { ascending: false })
  .order('data_inicio', { ascending: true });
---

<Layout title="Início - Encontre Feiras, Mercados e Festas em Portugal">
  <!-- Secção Hero -->
  <section class="bg-gradient-to-r from-amber-500 to-orange-600 rounded-2xl p-6 sm:p-8 text-white mb-8 shadow-lg">
    <h1 class="text-2xl sm:text-4xl font-extrabold mb-2">
      O que há para fazer em Portugal?
    </h1>
    <p class="text-amber-100 text-sm sm:text-base mb-4">
      Descubra feiras velhas, mercados locais, romarias, festas populares e concertos perto de si.
    </p>
  </section>

  <!-- Lista de Eventos -->
  <section class="mb-12">
    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
      <span>🎉</span> Próximos Eventos & Festas
    </h2>

    {error && (
      <div class="p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm">
        Erro ao carregar os eventos. Por favor tente mais tarde.
      </div>
    )}

    {eventos && eventos.length === 0 && (
      <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center shadow-sm">
        <span class="text-4xl mb-3 block">🎪</span>
        <h3 class="text-lg font-bold text-gray-800 mb-1">Ainda não há eventos listados</h3>
        <p class="text-gray-500 text-sm mb-4">Seja o primeiro a divulgar uma feira ou festa na sua região!</p>
        <a href="/submeter" class="inline-block bg-amber-500 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-amber-600 transition-all text-sm shadow-sm">
          + Submeter Primeiro Evento
        </a>
      </div>
    )}

    {eventos && eventos.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {eventos.map((evento) => (
          <article class={`bg-white rounded-2xl overflow-hidden border ${evento.destaque ? 'border-amber-400 ring-2 ring-amber-400/20 shadow-md' : 'border-gray-200 shadow-sm'} flex flex-col justify-between hover:shadow-md transition-all`}>
            {evento.imagem_url && (
              <img 
                src={evento.imagem_url} 
                alt={evento.titulo} 
                class="w-full h-48 object-cover"
              />
            )}
            
            <div class="p-5 flex-grow flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 capitalize">
                    {evento.categoria}
                  </span>
                  {evento.destaque && (
                    <span class="text-xs font-bold px-2 py-0.5 rounded bg-amber-500 text-white flex items-center gap-1">
                      ⭐ Destaque
                    </span>
                  )}
                </div>

                <h3 class="font-bold text-lg text-gray-900 mb-2 line-clamp-2">
                  {evento.titulo}
                </h3>

                <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                  {evento.descricao}
                </p>
              </div>

              <div class="border-t border-gray-100 pt-3 mt-2 flex flex-col gap-2 text-xs text-gray-600">
                <div class="flex items-center gap-1.5">
                  <span>📍</span>
                  <span class="font-medium text-gray-800">{evento.localizacao_nome} ({evento.concelho}, {evento.distrito})</span>
                </div>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span>📅</span>
                    <span>{new Date(evento.data_inicio).toLocaleDateString('pt-PT')}</span>
                  </div>

                  <span class="font-semibold text-amber-700 bg-amber-50 px-2 py-0.5 rounded">
                    {evento.tipo_entrada || 'Gratuito'}
                  </span>
                </div>

                <!-- Botões de GPS/Navegação (se houver coordenadas) -->
                {(evento.latitude && evento.longitude) && (
                  <div class="pt-2 flex gap-2">
                    <a 
                      href={`https://www.google.com/maps/search/?api=1&query=${evento.latitude},${evento.longitude}`} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="flex-1 text-center py-1.5 px-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-medium transition-all"
                    >
                      🗺️ Google Maps
                    </a>
                    <a 
                      href={`https://waze.com/ul?ll=${evento.latitude},${evento.longitude}&navigate=yes`} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="flex-1 text-center py-1.5 px-2 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg text-xs font-medium transition-all"
                    >
                      🚗 Waze
                    </a>
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>
