---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Painel de Administração - Feiras e Festas">
  <main class="max-w-6xl mx-auto p-4 md:p-6">
    
    <!-- ÉCRÃ DE LOGIN -->
    <div id="login-container" class="max-w-md mx-auto my-12 bg-white p-6 rounded-xl shadow-md border border-gray-100">
      <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">🔑 Acesso Admin</h1>
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="email" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Palavra-passe</label>
          <input type="password" id="password" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div id="login-error" class="text-red-600 text-sm hidden"></div>
        <button type="submit" id="btn-login" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition">
          Entrar
        </button>
      </form>
    </div>

    <!-- PAINEL DE ADMINISTRAÇÃO (Escondido por padrão) -->
    <div id="admin-dashboard" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-6 rounded-xl shadow-sm border border-gray-100 gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Painel de Moderação</h1>
          <p id="user-info" class="text-sm text-gray-500"></p>
        </div>
        <button id="btn-logout" class="bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-lg text-sm font-medium transition">
          Sair da Conta
        </button>
      </div>

      <!-- SEPARADORES -->
      <div class="flex border-b border-gray-200 gap-4">
        <button id="tab-pendentes" class="py-2 px-4 border-b-2 border-indigo-600 font-semibold text-indigo-600 text-sm">
          ⏳ Pendentes (<span id="count-pendentes">0</span>)
        </button>
        <button id="tab-aprovados" class="py-2 px-4 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 text-sm">
          ✅ Aprovados (<span id="count-aprovados">0</span>)
        </button>
        <button id="tab-reportes" class="py-2 px-4 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 text-sm">
          🚩 Denúncias (<span id="count-reportes">0</span>)
        </button>
      </div>

      <!-- LISTA DE CONTEÚDO -->
      <div id="content-list" class="grid gap-4">
        <p class="text-gray-500 text-center py-8">A carregar dados...</p>
      </div>
    </div>

  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const loginContainer = document.getElementById('login-container');
  const adminDashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const loginError = document.getElementById('login-error');
  const userInfo = document.getElementById('user-info');
  const btnLogout = document.getElementById('btn-logout');
  const contentList = document.getElementById('content-list');

  let currentTab = 'pendentes';

  // Verificar Sessão ao Carregar a Página
  async function checkSession() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      // Verificar perfil/role no Supabase
      const { data: perfil } = await supabase
        .from('perfis')
        .select('role')
        .eq('id', session.user.id)
        .single();

      if (perfil && perfil.role === 'admin') {
        loginContainer?.classList.add('hidden');
        adminDashboard?.classList.remove('hidden');
        if (userInfo) userInfo.textContent = `Sessão iniciada como: ${session.user.email}`;
        loadTabContent();
        return;
      } else {
        if (loginError) {
          loginError.textContent = 'Acesso negado: A sua conta não tem privilégios de Administrador.';
          loginError.classList.remove('hidden');
        }
        await supabase.auth.signOut();
      }
    }

    // Se não houver sessão ativa
    loginContainer?.classList.remove('hidden');
    adminDashboard?.classList.add('hidden');
  }

  // Executar ao carregar
  checkSession();

  // Submissão do Login
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (loginError) loginError.classList.add('hidden');

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      if (loginError) {
        loginError.textContent = 'Erro de autenticação: Email ou palavra-passe incorretos.';
        loginError.classList.remove('hidden');
      }
    } else {
      checkSession();
    }
  });

  // Terminar Sessão (Logout)
  btnLogout?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });

  // Alternar Separadores
  document.getElementById('tab-pendentes')?.addEventListener('click', () => switchTab('pendentes'));
  document.getElementById('tab-aprovados')?.addEventListener('click', () => switchTab('aprovados'));
  document.getElementById('tab-reportes')?.addEventListener('click', () => switchTab('reportes'));

  function switchTab(tab: string) {
    currentTab = tab;
    ['pendentes', 'aprovados', 'reportes'].forEach(t => {
      const btn = document.getElementById(`tab-${t}`);
      if (t === tab) {
        btn?.classList.add('border-indigo-600', 'text-indigo-600', 'font-semibold');
        btn?.classList.remove('border-transparent', 'text-gray-500');
      } else {
        btn?.classList.remove('border-indigo-600', 'text-indigo-600', 'font-semibold');
        btn?.classList.add('border-transparent', 'text-gray-500');
      }
    });
    loadTabContent();
  }

  // Carregar Dados Conforme o Separador
  async function loadTabContent() {
    if (!contentList) return;
    contentList.innerHTML = '<p class="text-gray-500 text-center py-8">A carregar...</p>';

    if (currentTab === 'pendentes' || currentTab === 'aprovados') {
      const isAprovado = currentTab === 'aprovados';
      const { data: eventos, error } = await supabase
        .from('eventos')
        .select('*')
        .eq('aprovado', isAprovado)
        .order('data_inicio', { ascending: true });

      if (error || !eventos || eventos.length === 0) {
        contentList.innerHTML = `<p class="text-gray-500 text-center py-8">Nenhum evento ${isAprovado ? 'aprovado' : 'pendente'}.</p>`;
        return;
      }

      contentList.innerHTML = eventos.map(ev => `
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2 py-1 rounded">${ev.categoria}</span>
            <h3 class="font-bold text-lg text-gray-800 mt-1">${ev.titulo}</h3>
            <p class="text-sm text-gray-600">📍 ${ev.localizacao} (${ev.freguesia_concelho})</p>
            <p class="text-xs text-gray-400 mt-1">📅 ${ev.data_inicio} até ${ev.data_fim}</p>
          </div>
          <div class="flex gap-2 w-full md:w-auto">
            ${!isAprovado ? `
              <button onclick="aprovarEvento('${ev.id}')" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded text-sm font-medium transition flex-1 md:flex-none">
                Aprovar
              </button>
            ` : ''}
            <button onclick="eliminarEvento('${ev.id}')" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded text-sm font-medium transition flex-1 md:flex-none">
              Eliminar
            </button>
          </div>
        </div>
      `).join('');
    } else if (currentTab === 'reportes') {
      const { data: reportes, error } = await supabase
        .from('reportes')
        .select('*, eventos(titulo, localizacao)')
        .order('created_at', { ascending: false });

      if (error || !reportes || reportes.length === 0) {
        contentList.innerHTML = '<p class="text-gray-500 text-center py-8">Nenhuma denúncia registada.</p>';
        return;
      }

      contentList.innerHTML = reportes.map(rep => `
        <div class="bg-white p-4 rounded-lg shadow-sm border border-red-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div>
            <span class="text-xs font-bold uppercase text-red-600 bg-red-50 px-2 py-1 rounded">Denúncia</span>
            <h3 class="font-bold text-gray-800 mt-1">Evento: ${rep.eventos?.titulo || 'Desconhecido'}</h3>
            <p class="text-sm text-gray-700 bg-gray-50 p-2 rounded mt-2"><strong>Motivo:</strong> ${rep.motivo}</p>
          </div>
          <div class="flex gap-2 w-full md:w-auto">
            <button onclick="resolverReporte('${rep.id}')" class="bg-gray-600 hover:bg-gray-700 text-white px-3 py-1.5 rounded text-sm font-medium transition flex-1 md:flex-none">
              Limpar Denúncia
            </button>
            <button onclick="eliminarEvento('${rep.evento_id}')" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded text-sm font-medium transition flex-1 md:flex-none">
              Apagar Evento
            </button>
          </div>
        </div>
      `).join('');
    }
  }

  // Ações de Moderação Globais
  (window as any).aprovarEvento = async (id: string) => {
    await supabase.from('eventos').update({ aprovado: true }).eq('id', id);
    loadTabContent();
  };

  (window as any).eliminarEvento = async (id: string) => {
    if (confirm('Tem a certeza que deseja eliminar este evento?')) {
      await supabase.from('eventos').delete().eq('id', id);
      loadTabContent();
    }
  };

  (window as any).resolverReporte = async (id: string) => {
    await supabase.from('reportes').delete().eq('id', id);
    loadTabContent();
  };
</script>
