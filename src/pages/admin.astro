---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Painel de Administração - Feiras e Festas">
  <main class="max-w-6xl mx-auto p-4 md:p-6">
    
    <!-- ÉCRÃ DE LOGIN -->
    <div id="login-container" class="max-w-md mx-auto my-12 bg-white p-6 rounded-xl shadow-md border border-gray-100">
      <h1 class="text-2xl font-bold text-center text-gray-800 mb-6">🔑 Acesso Admin</h1>
      <form id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="email" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Palavra-passe</label>
          <input type="password" id="password" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />
        </div>
        <div id="login-error" class="text-red-600 text-sm hidden"></div>
        <button type="submit" id="btn-login" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 rounded-lg transition">
          Entrar
        </button>
      </form>
    </div>

    <!-- PAINEL DE ADMINISTRAÇÃO -->
    <div id="admin-dashboard" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-6 rounded-xl shadow-sm border border-gray-100 gap-4">
        <div>
          <h1 class="text-2xl font-bold text-gray-800">Painel de Moderação</h1>
          <p id="user-info" class="text-sm text-gray-500"></p>
        </div>
        <button id="btn-logout" class="bg-red-50 hover:bg-red-100 text-red-600 px-4 py-2 rounded-lg text-sm font-medium transition">
          Sair da Conta
        </button>
      </div>

      <!-- SEPARADORES COM CONTADORES -->
      <div class="flex border-b border-gray-200 gap-2 sm:gap-4 overflow-x-auto">
        <button id="tab-pendentes" class="py-3 px-4 border-b-2 border-indigo-600 font-semibold text-indigo-600 text-sm whitespace-nowrap">
          ⏳ Pendentes (<span id="count-pendentes">0</span>)
        </button>
        <button id="tab-aprovados" class="py-3 px-4 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 text-sm whitespace-nowrap">
          ✅ Aprovados (<span id="count-aprovados">0</span>)
        </button>
        <button id="tab-rejeitados" class="py-3 px-4 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 text-sm whitespace-nowrap">
          🚫 Rejeitados / Banidos (<span id="count-rejeitados">0</span>)
        </button>
      </div>

      <!-- LISTA DE CONTEÚDO -->
      <div id="content-list" class="grid gap-6">
        <p class="text-gray-500 text-center py-8">A carregar dados...</p>
      </div>
    </div>

    <!-- MODAL DE EDIÇÃO -->
    <div id="edit-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
      <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 shadow-2xl">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
          <h2 class="text-xl font-bold text-gray-800">✏️ Editar Evento</h2>
          <button onclick="fecharModal()" class="text-gray-400 hover:text-gray-600 font-bold text-xl">&times;</button>
        </div>
        <form id="edit-form" class="space-y-4">
          <input type="hidden" id="edit-id" />
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Título</label>
              <input type="text" id="edit-titulo" required class="w-full p-2.5 border rounded-lg text-sm" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Categoria</label>
              <input type="text" id="edit-categoria" required class="w-full p-2.5 border rounded-lg text-sm" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Localização / Recinto</label>
              <input type="text" id="edit-localizacao" class="w-full p-2.5 border rounded-lg text-sm" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Freguesia / Concelho</label>
              <input type="text" id="edit-freguesia" class="w-full p-2.5 border rounded-lg text-sm" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Data Início</label>
              <input type="date" id="edit-data-inicio" class="w-full p-2.5 border rounded-lg text-sm" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-600 mb-1">Data Fim</label>
              <input type="date" id="edit-data-fim" class="w-full p-2.5 border rounded-lg text-sm" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">URL da Imagem / Cartaz</label>
            <input type="url" id="edit-imagem" class="w-full p-2.5 border rounded-lg text-sm" placeholder="https://..." />
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Contacto / Organizador</label>
            <input type="text" id="edit-contacto" class="w-full p-2.5 border rounded-lg text-sm" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Descrição Completa</label>
            <textarea id="edit-descricao" rows="5" class="w-full p-2.5 border rounded-lg text-sm leading-relaxed"></textarea>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Estado do Anúncio</label>
            <select id="edit-status" class="w-full p-2.5 border rounded-lg text-sm bg-white">
              <option value="pendente">⏳ Pendente</option>
              <option value="aprovado">✅ Aprovado</option>
              <option value="rejeitado">🚫 Rejeitado / Banido</option>
            </select>
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t">
            <button type="button" onclick="fecharModal()" class="px-4 py-2 border rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50">Cancelar</button>
            <button type="submit" class="px-5 py-2 bg-indigo-600 text-white rounded-lg text-sm font-semibold hover:bg-indigo-700">Guardar Alterações</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const loginContainer = document.getElementById('login-container');
  const adminDashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const loginError = document.getElementById('login-error');
  const userInfo = document.getElementById('user-info');
  const btnLogout = document.getElementById('btn-logout');
  const contentList = document.getElementById('content-list');
  const editModal = document.getElementById('edit-modal');
  const editForm = document.getElementById('edit-form');

  let currentTab = 'pendentes';
  let eventosCache: any[] = [];

  // Verificar Sessão
  async function checkSession() {
    const { data: { session } } = await supabase.auth.getSession();

    if (session) {
      const { data: perfil } = await supabase
        .from('perfis')
        .select('role')
        .eq('id', session.user.id)
        .single();

      if (perfil && perfil.role === 'admin') {
        loginContainer?.classList.add('hidden');
        adminDashboard?.classList.remove('hidden');
        if (userInfo) userInfo.textContent = `Sessão iniciada como: ${session.user.email}`;
        refreshDashboard();
        return;
      } else {
        if (loginError) {
          loginError.textContent = 'Acesso negado: A sua conta não tem privilégios de Administrador.';
          loginError.classList.remove('hidden');
        }
        await supabase.auth.signOut();
      }
    }

    loginContainer?.classList.remove('hidden');
    adminDashboard?.classList.add('hidden');
  }

  checkSession();

  // Login
  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (loginError) loginError.classList.add('hidden');

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    const { error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      if (loginError) {
        loginError.textContent = 'Erro de autenticação: Email ou palavra-passe incorretos.';
        loginError.classList.remove('hidden');
      }
    } else {
      checkSession();
    }
  });

  // Logout
  btnLogout?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.reload();
  });

  // Atualizar Contadores e Conteúdo
  async function refreshDashboard() {
    await updateCounters();
    await loadTabContent();
  }

  // Atualizar Contadores em Tempo Real
  async function updateCounters() {
    const { count: pendentesCount } = await supabase.from('eventos').select('*', { count: 'exact', head: true }).eq('status', 'pendente');
    const { count: aprovadosCount } = await supabase.from('eventos').select('*', { count: 'exact', head: true }).eq('status', 'aprovado');
    const { count: rejeitadosCount } = await supabase.from('eventos').select('*', { count: 'exact', head: true }).eq('status', 'rejeitado');

    const elP = document.getElementById('count-pendentes');
    const elA = document.getElementById('count-aprovados');
    const elR = document.getElementById('count-rejeitados');

    if (elP) elP.textContent = (pendentesCount || 0).toString();
    if (elA) elA.textContent = (aprovadosCount || 0).toString();
    if (elR) elR.textContent = (rejeitadosCount || 0).toString();
  }

  // Alternar Separadores
  document.getElementById('tab-pendentes')?.addEventListener('click', () => switchTab('pendentes'));
  document.getElementById('tab-aprovados')?.addEventListener('click', () => switchTab('aprovados'));
  document.getElementById('tab-rejeitados')?.addEventListener('click', () => switchTab('rejeitados'));

  function switchTab(tab: string) {
    currentTab = tab;
    ['pendentes', 'aprovados', 'rejeitados'].forEach(t => {
      const btn = document.getElementById(`tab-${t}`);
      if (t === tab) {
        btn?.classList.add('border-indigo-600', 'text-indigo-600', 'font-semibold');
        btn?.classList.remove('border-transparent', 'text-gray-500');
      } else {
        btn?.classList.remove('border-indigo-600', 'text-indigo-600', 'font-semibold');
        btn?.classList.add('border-transparent', 'text-gray-500');
      }
    });
    loadTabContent();
  }

  // Carregar Eventos Completos
  async function loadTabContent() {
    if (!contentList) return;
    contentList.innerHTML = '<p class="text-gray-500 text-center py-8">A carregar...</p>';

    const statusMap: Record<string, string> = {
      'pendentes': 'pendente',
      'aprovados': 'aprovado',
      'rejeitados': 'rejeitado'
    };

    const targetStatus = statusMap[currentTab] || 'pendente';

    // Procura eventos e inclui a lista de reportes associados
    const { data: eventos, error } = await supabase
      .from('eventos')
      .select('*, reportes(*)')
      .eq('status', targetStatus)
      .order('data_inicio', { ascending: true });

    if (error || !eventos || eventos.length === 0) {
      contentList.innerHTML = `<p class="text-gray-500 text-center py-8">Nenhum evento no separador "${currentTab}".</p>`;
      return;
    }

    eventosCache = eventos;

    contentList.innerHTML = eventos.map(ev => {
      const reportes = ev.reportes || [];
      const likes = ev.likes || 0;
      const dislikes = ev.dislikes || 0;

      return `
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 space-y-4">
          <!-- CABEÇALHO -->
          <div class="flex flex-col sm:flex-row justify-between items-start gap-4 border-b pb-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-bold uppercase text-indigo-600 bg-indigo-50 px-2.5 py-1 rounded-md">${ev.categoria || 'Geral'}</span>
                <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-md">ID: ${ev.id}</span>
              </div>
              <h3 class="font-bold text-xl text-gray-900">${ev.titulo}</h3>
            </div>
            
            <div class="flex items-center gap-3 bg-gray-50 p-2 rounded-lg border text-sm text-gray-600">
              <span>👍 <strong>${likes}</strong></span>
              <span>👎 <strong>${dislikes}</strong></span>
              <span class="${reportes.length > 0 ? 'text-red-600 font-bold' : 'text-gray-400'}">🚩 <strong>${reportes.length}</strong> Denúncias</span>
            </div>
          </div>

          <!-- DETALHES E IMAGEM -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            ${ev.imagem_url ? `
              <div class="md:col-span-1">
                <img src="${ev.imagem_url}" alt="${ev.titulo}" class="w-full h-48 object-cover rounded-lg border shadow-sm" onerror="this.style.display='none'" />
              </div>
            ` : ''}
            
            <div class="${ev.imagem_url ? 'md:col-span-2' : 'md:col-span-3'} space-y-2 text-sm text-gray-700">
              <p>📍 <strong>Local:</strong> ${ev.localizacao || 'Não especificado'} (${ev.freguesia_concelho || 'N/D'})</p>
              <p>📅 <strong>Datas:</strong> ${ev.data_inicio || 'N/D'} até ${ev.data_fim || 'N/D'}</p>
              ${ev.contacto ? `<p>📞 <strong>Contacto/Organizador:</strong> ${ev.contacto}</p>` : ''}
              
              <div class="mt-3 bg-gray-50 p-3 rounded-lg border">
                <p class="font-semibold text-xs text-gray-500 uppercase mb-1">Descrição Completa:</p>
                <p class="text-gray-800 whitespace-pre-line text-sm">${ev.descricao || 'Sem descrição fornecida.'}</p>
              </div>
            </div>
          </div>

          <!-- LISTA DE DENÚNCIAS SE EXISTIREM -->
          ${reportes.length > 0 ? `
            <div class="bg-red-50 border border-red-200 rounded-lg p-3 space-y-2">
              <div class="flex justify-between items-center">
                <p class="text-xs font-bold text-red-700 uppercase">🚩 Denúncias Registadas sobre este evento:</p>
                <button onclick="limparDenuncias('${ev.id}')" class="text-xs text-red-600 underline hover:text-red-800">Limpar Denúncias</button>
              </div>
              <ul class="list-disc list-inside text-xs text-red-800 space-y-1">
                ${reportes.map((r: any) => `<li><strong>Motivo:</strong> ${r.motivo || 'Não especificado'}</li>`).join('')}
              </ul>
            </div>
          ` : ''}

          <!-- BOTÕES DE AÇÃO -->
          <div class="flex flex-wrap gap-2 pt-3 border-t justify-end">
            <button onclick="abrirModalEdicao('${ev.id}')" class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
              ✏️ Editar
            </button>
            
            ${ev.status !== 'aprovado' ? `
              <button onclick="alterarStatus('${ev.id}', 'aprovado')" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
                ✅ Aprovar
              </button>
            ` : ''}

            ${ev.status !== 'rejeitado' ? `
              <button onclick="alterarStatus('${ev.id}', 'rejeitado')" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
                🚫 Rejeitar / Banir
              </button>
            ` : ''}

            <button onclick="eliminarEvento('${ev.id}')" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition">
              🗑️ Eliminar Definitivamente
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  // Ações Globais de Alteração de Estado
  (window as any).alterarStatus = async (id: string, novoStatus: string) => {
    await supabase.from('eventos').update({ status: novoStatus }).eq('id', id);
    refreshDashboard();
  };

  (window as any).eliminarEvento = async (id: string) => {
    if (confirm('Tem a certeza que deseja eliminar permanentemente este evento?')) {
      await supabase.from('eventos').delete().eq('id', id);
      refreshDashboard();
    }
  };

  (window as any).limparDenuncias = async (eventoId: string) => {
    if (confirm('Deseja eliminar todas as denúncias associadas a este evento?')) {
      await supabase.from('reportes').delete().eq('evento_id', eventoId);
      refreshDashboard();
    }
  };

  // Funções do Modal de Edição
  (window as any).abrirModalEdicao = (id: string) => {
    const ev = eventosCache.find(e => e.id === id);
    if (!ev) return;

    (document.getElementById('edit-id') as HTMLInputElement).value = ev.id || '';
    (document.getElementById('edit-titulo') as HTMLInputElement).value = ev.titulo || '';
    (document.getElementById('edit-categoria') as HTMLInputElement).value = ev.categoria || '';
    (document.getElementById('edit-localizacao') as HTMLInputElement).value = ev.localizacao || '';
    (document.getElementById('edit-freguesia') as HTMLInputElement).value = ev.freguesia_concelho || '';
    (document.getElementById('edit-data-inicio') as HTMLInputElement).value = ev.data_inicio || '';
    (document.getElementById('edit-data-fim') as HTMLInputElement).value = ev.data_fim || '';
    (document.getElementById('edit-imagem') as HTMLInputElement).value = ev.imagem_url || '';
    (document.getElementById('edit-contacto') as HTMLInputElement).value = ev.contacto || '';
    (document.getElementById('edit-descricao') as HTMLTextAreaElement).value = ev.descricao || '';
    (document.getElementById('edit-status') as HTMLSelectElement).value = ev.status || 'pendente';

    editModal?.classList.remove('hidden');
  };

  (window as any).fecharModal = () => {
    editModal?.classList.add('hidden');
  };

  // Submissão do Formulário de Edição
  editForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const id = (document.getElementById('edit-id') as HTMLInputElement).value;

    const payload = {
      titulo: (document.getElementById('edit-titulo') as HTMLInputElement).value,
      categoria: (document.getElementById('edit-categoria') as HTMLInputElement).value,
      localizacao: (document.getElementById('edit-localizacao') as HTMLInputElement).value,
      freguesia_concelho: (document.getElementById('edit-freguesia') as HTMLInputElement).value,
      data_inicio: (document.getElementById('edit-data-inicio') as HTMLInputElement).value,
      data_fim: (document.getElementById('edit-data-fim') as HTMLInputElement).value,
      imagem_url: (document.getElementById('edit-imagem') as HTMLInputElement).value,
      contacto: (document.getElementById('edit-contacto') as HTMLInputElement).value,
      descricao: (document.getElementById('edit-descricao') as HTMLTextAreaElement).value,
      status: (document.getElementById('edit-status') as HTMLSelectElement).value,
    };

    const { error } = await supabase.from('eventos').update(payload).eq('id', id);

    if (error) {
      alert('Erro ao atualizar o evento: ' + error.message);
    } else {
      (window as any).fecharModal();
      refreshDashboard();
    }
  });
</script>
