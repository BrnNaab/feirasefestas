---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submeter Evento - Feiras e Festas">
  <main class="max-w-3xl mx-auto p-4 md:p-6 my-8">
    <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-gray-100">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">📢 Divulgar Feira ou Festa</h1>
      <p class="text-sm text-gray-500 mb-6">Preencha os dados do seu evento. A submissão será analisada pela moderação antes de ser publicada.</p>

      <form id="form-submeter" class="space-y-6">
        
        <!-- TÍTULO E CATEGORIA -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Nome do Evento *</label>
            <input type="text" id="titulo" required placeholder="Ex: Feira Franca de Maio" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Categoria *</label>
            <select id="categoria" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white">
              <option value="">Selecione uma categoria...</option>
              <option value="Feira">Feira</option>
              <option value="Festa Popular">Festa Popular</option>
              <option value="Festival">Festival</option>
              <option value="Romaria">Romaria / Religioso</option>
              <option value="Mercado">Mercado Temático</option>
              <option value="Outro">Outro</option>
            </select>
          </div>
        </div>

        <!-- LOCALIZAÇÃO -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Local / Recinto *</label>
            <input type="text" id="localizacao" required placeholder="Ex: Campo da Feira, Parque de Festas" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Freguesia e Concelho *</label>
            <input type="text" id="freguesia_concelho" required placeholder="Ex: Azambuja, Lisboa" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm" />
          </div>
        </div>

        <!-- DATAS -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Data de Início *</label>
            <input type="date" id="data_inicio" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Data de Fim *</label>
            <input type="date" id="data_fim" required class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm" />
          </div>
        </div>

        <!-- UPLOAD DE IMAGEM / CARTAZ -->
        <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 space-y-3">
          <label class="block text-sm font-semibold text-gray-700">🖼️ Cartaz ou Fotografia do Evento</label>
          <input type="file" id="ficheiro-imagem" accept="image/*" class="w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer" />
          <p class="text-xs text-gray-400">Ou introduza o URL direto de uma imagem já alojada online:</p>
          <input type="url" id="imagem_url" placeholder="https://exemplo.com/cartaz.jpg" class="w-full p-2.5 border border-gray-300 rounded-lg outline-none text-sm" />
        </div>

        <!-- REDES SOCIAIS / BANNERS -->
        <div class="bg-blue-50/40 p-4 rounded-xl border border-blue-100 space-y-3">
          <p class="text-xs font-bold text-blue-900 uppercase tracking-wider">📱 Banners / Divulgação nas Redes Sociais (Opcional)</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Link do Evento / Post no Facebook</label>
              <input type="url" id="facebook_url" placeholder="https://facebook.com/events/..." class="w-full p-2.5 border border-gray-300 rounded-lg outline-none text-sm" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Link da Publicação no Instagram</label>
              <input type="url" id="instagram_url" placeholder="https://instagram.com/p/..." class="w-full p-2.5 border border-gray-300 rounded-lg outline-none text-sm" />
            </div>
          </div>
        </div>

        <!-- CONTACTO E DESCRIÇÃO -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Contacto da Organização / Email *</label>
          <input type="text" id="contacto" required placeholder="Ex: comissao@feiras.pt ou 912 345 678" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Descrição Completa e Programa *</label>
          <textarea id="descricao" rows="5" required placeholder="Descreva os destaques do evento, horários, artistas, entradas gratuitas/pagas, etc." class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm leading-relaxed"></textarea>
        </div>

        <div id="msg-resposta" class="hidden p-4 rounded-lg text-sm font-medium"></div>

        <button type="submit" id="btn-submeter" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl transition shadow-md">
          🚀 Submeter Evento para Moderação
        </button>

      </form>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('form-submeter') as HTMLFormElement;
  const msgResposta = document.getElementById('msg-resposta');
  const btnSubmeter = document.getElementById('btn-submeter') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (btnSubmeter) {
      btnSubmeter.disabled = true;
      btnSubmeter.textContent = 'A enviar evento...';
    }

    if (msgResposta) msgResposta.classList.add('hidden');

    let finalImageUrl = (document.getElementById('imagem_url') as HTMLInputElement).value;
    const fileInput = document.getElementById('ficheiro-imagem') as HTMLInputElement;

    // 1. Fazer upload da imagem para o Supabase Storage se um ficheiro for selecionado
    if (fileInput?.files && fileInput.files.length > 0) {
      const file = fileInput.files[0];
      const fileExt = file.name.split('.').pop();
      const fileName = `${Date.now()}_${Math.random().toString(36).substring(2)}.${fileExt}`;
      
      const { data: uploadData, error: uploadError } = await supabase.storage
        .from('eventos')
        .upload(fileName, file);

      if (uploadError) {
        exibirMensagem('Erro ao carregar a imagem: ' + uploadError.message, 'erro');
        restaurarBotao();
        return;
      }

      // Obter URL pública da imagem carregada
      const { data: publicUrlData } = supabase.storage
        .from('eventos')
        .getPublicUrl(fileName);

      finalImageUrl = publicUrlData.publicUrl;
    }

    // 2. Preparar os dados para inserir na tabela eventos
    const payload = {
      titulo: (document.getElementById('titulo') as HTMLInputElement).value,
      categoria: (document.getElementById('categoria') as HTMLSelectElement).value,
      localizacao: (document.getElementById('localizacao') as HTMLInputElement).value,
      freguesia_concelho: (document.getElementById('freguesia_concelho') as HTMLInputElement).value,
      data_inicio: (document.getElementById('data_inicio') as HTMLInputElement).value,
      data_fim: (document.getElementById('data_fim') as HTMLInputElement).value,
      imagem_url: finalImageUrl || null,
      facebook_url: (document.getElementById('facebook_url') as HTMLInputElement).value || null,
      instagram_url: (document.getElementById('instagram_url') as HTMLInputElement).value || null,
      contacto: (document.getElementById('contacto') as HTMLInputElement).value,
      descricao: (document.getElementById('descricao') as HTMLTextAreaElement).value,
      status: 'pendente' // Fica aguardando aprovação no painel de admin
    };

    // 3. Enviar para a base de dados
    const { error } = await supabase.from('eventos').insert([payload]);

    if (error) {
      exibirMensagem('Erro ao submeter o evento: ' + error.message, 'erro');
    } else {
      exibirMensagem('🎉 Evento submetido com sucesso! A equipa de moderação irá analisar o seu anúncio brevemente.', 'sucesso');
      form.reset();
    }

    restaurarBotao();
  });

  function exibirMensagem(texto: string, tipo: 'sucesso' | 'erro') {
    if (!msgResposta) return;
    msgResposta.textContent = texto;
    msgResposta.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800');

    if (tipo === 'sucesso') {
      msgResposta.classList.add('bg-green-50', 'text-green-800', 'border', 'border-green-200');
    } else {
      msgResposta.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
    }
  }

  function restaurarBotao() {
    if (btnSubmeter) {
      btnSubmeter.disabled = false;
      btnSubmeter.textContent = '🚀 Submeter Evento para Moderação';
    }
  }
</script>
