---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Submeter Evento - Divulgue a sua Feira ou Festa">
  <div class="max-w-3xl mx-auto bg-white p-6 sm:p-10 rounded-2xl shadow-sm border border-gray-200 my-4">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-2">
      📢 Divulgar Evento ou Festa
    </h1>
    <p class="text-gray-600 text-sm mb-8">
      Preencha o formulário abaixo. Após a submissão, a nossa equipa irá rever e publicar o evento no site.
    </p>

    <div id="mensagem-sucesso" class="hidden p-6 bg-green-50 border border-green-200 text-green-800 rounded-xl mb-6 text-center">
      <span class="text-3xl mb-2 block">🎉</span>
      <h3 class="font-bold text-lg mb-1">Evento Submetido com Sucesso!</h3>
      <p class="text-sm text-green-700">O seu evento está pendente de aprovação e estará visível em breve. Obrigado!</p>
      <a href="/" class="inline-block mt-4 text-xs font-bold text-green-800 underline">Voltar à Página Inicial</a>
    </div>

    <div id="mensagem-erro" class="hidden p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl mb-6 text-sm"></div>

    <form id="form-submeter" class="space-y-6">
      
      <!-- SECÇÃO 1: INFORMAÇÃO PÚBLICA -->
      <div class="border-b border-gray-200 pb-6">
        <h2 class="text-lg font-bold text-amber-600 mb-4 flex items-center gap-2">
          <span>🎪</span> Informação Pública do Evento
        </h2>

        <div class="space-y-4">
          <div>
            <label for="titulo" class="block text-xs font-bold text-gray-700 uppercase mb-1">Título do Evento *</label>
            <input type="text" id="titulo" name="titulo" required placeholder="Ex: Feira Medieval de Silves" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="categoria" class="block text-xs font-bold text-gray-700 uppercase mb-1">Categoria *</label>
              <select id="categoria" name="categoria" required class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none">
                <option value="feira">Feira / Mercado</option>
                <option value="festa">Festa Pop / Romaria</option>
                <option value="concerto_noite">Concerto / Noite</option>
                <option value="circo_lazer">Circo / Lazer</option>
                <option value="workshop">Workshop / Exposição</option>
              </select>
            </div>

            <div>
              <label for="tipo_entrada" class="block text-xs font-bold text-gray-700 uppercase mb-1">Entrada *</label>
              <select id="tipo_entrada" name="tipo_entrada" required class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none">
                <option value="Gratuito">Gratuito (Entrada Livre)</option>
                <option value="Pago">Pago</option>
                <option value="Consumição">Consumição Obrigatória</option>
              </select>
            </div>
          </div>

          <div>
            <label for="descricao" class="block text-xs font-bold text-gray-700 uppercase mb-1">Descrição Detalhada *</label>
            <textarea id="descricao" name="descricao" rows="4" required placeholder="Explique o que os visitantes vão encontrar, atrações, banquinhas, programas, etc." class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none"></textarea>
          </div>

          <div>
            <label for="imagem_url" class="block text-xs font-bold text-gray-700 uppercase mb-1">URL da Imagem / Cartaz (Opcional)</label>
            <input type="url" id="imagem_url" name="imagem_url" placeholder="https://exemplo.com/cartaz.jpg" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
          </div>
        </div>
      </div>

      <!-- SECÇÃO 2: LOCALIZAÇÃO -->
      <div class="border-b border-gray-200 pb-6">
        <h2 class="text-lg font-bold text-amber-600 mb-4 flex items-center gap-2">
          <span>📍</span> Localização & GPS
        </h2>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="distrito" class="block text-xs font-bold text-gray-700 uppercase mb-1">Distrito *</label>
              <input type="text" id="distrito" name="distrito" required placeholder="Ex: Faro" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
            </div>

            <div>
              <label for="concelho" class="block text-xs font-bold text-gray-700 uppercase mb-1">Concelho *</label>
              <input type="text" id="concelho" name="concelho" required placeholder="Ex: Silves" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
            </div>
          </div>

          <div>
            <label for="localizacao_nome" class="block text-xs font-bold text-gray-700 uppercase mb-1">Nome do Local *</label>
            <input type="text" id="localizacao_nome" name="localizacao_nome" required placeholder="Ex: Centro Histórico / Pavilhão Multiusos" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="latitude" class="block text-xs font-bold text-gray-700 uppercase mb-1">Latitude (Opcional p/ GPS)</label>
              <input type="number" step="any" id="latitude" name="latitude" placeholder="Ex: 37.1888" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
            </div>

            <div>
              <label for="longitude" class="block text-xs font-bold text-gray-700 uppercase mb-1">Longitude (Opcional p/ GPS)</label>
              <input type="number" step="any" id="longitude" name="longitude" placeholder="Ex: -8.4397" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
            </div>
          </div>
        </div>
      </div>

      <!-- SECÇÃO 3: DATAS E CONTACTO PÚBLICO -->
      <div class="border-b border-gray-200 pb-6">
        <h2 class="text-lg font-bold text-amber-600 mb-4 flex items-center gap-2">
          <span>📅</span> Datas e Contacto do Evento
        </h2>

        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="data_inicio" class="block text-xs font-bold text-gray-700 uppercase mb-1">Data e Hora de Início *</label>
              <input type="datetime-local" id="data_inicio" name="data_inicio" required class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
            </div>

            <div>
              <label for="data_fim" class="block text-xs font-bold text-gray-700 uppercase mb-1">Data e Hora de Fim (Opcional)</label>
              <input type="datetime-local" id="data_fim" name="data_fim" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
            </div>
          </div>

          <div>
            <label for="contacto_organizador" class="block text-xs font-bold text-gray-700 uppercase mb-1">Contacto Público do Evento *</label>
            <input type="text" id="contacto_organizador" name="contacto_organizador" required placeholder="Ex: 912 345 678 ou geral@evento.pt" class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 focus:bg-white outline-none" />
          </div>
        </div>
      </div>

      <!-- SECÇÃO 4: DADOS PRIVADOS DO ANUNCIANTE (ADMIN) -->
      <div class="bg-amber-50/60 p-5 rounded-xl border border-amber-200">
        <h2 class="text-base font-bold text-amber-900 mb-1 flex items-center gap-2">
          <span>🔒</span> Dados do Anunciante (Privado)
        </h2>
        <p class="text-xs text-amber-700 mb-4">
          Estes dados NÃO serão exibidos publicamente no site. Serão usados apenas pela administração para gestão e validação do anúncio.
        </p>

        <div class="space-y-4">
          <div>
            <label for="anunciante_nome" class="block text-xs font-bold text-gray-700 uppercase mb-1">O seu Nome / Empresa *</label>
            <input type="text" id="anunciante_nome" name="anunciante_nome" required placeholder="Ex: João Silva" class="w-full px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 outline-none" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="anunciante_email" class="block text-xs font-bold text-gray-700 uppercase mb-1">O seu Email *</label>
              <input type="email" id="anunciante_email" name="anunciante_email" required placeholder="joao@exemplo.com" class="w-full px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 outline-none" />
            </div>

            <div>
              <label for="anunciante_telefone" class="block text-xs font-bold text-gray-700 uppercase mb-1">O seu Telefone / WhatsApp</label>
              <input type="tel" id="anunciante_telefone" name="anunciante_telefone" placeholder="912 345 678" class="w-full px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-sm text-gray-900 focus:ring-2 focus:ring-amber-500 outline-none" />
            </div>
          </div>
        </div>
      </div>

      <button type="submit" id="btn-submit" class="w-full py-3.5 bg-amber-500 text-white font-bold rounded-xl shadow-md hover:bg-amber-600 transition-all text-base cursor-pointer">
        Submeter Evento para Moderação
      </button>
    </form>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.getElementById('form-submeter') as HTMLFormElement;
  const msgSucesso = document.getElementById('mensagem-sucesso');
  const msgErro = document.getElementById('mensagem-erro');
  const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    btnSubmit.disabled = true;
    btnSubmit.innerText = 'A submeter...';
    msgErro?.classList.add('hidden');

    const formData = new FormData(form);

    const novoEvento = {
      titulo: formData.get('titulo'),
      categoria: formData.get('categoria'),
      tipo_entrada: formData.get('tipo_entrada'),
      descricao: formData.get('descricao'),
      imagem_url: formData.get('imagem_url') || null,
      distrito: formData.get('distrito'),
      concelho: formData.get('concelho'),
      localizacao_nome: formData.get('localizacao_nome'),
      latitude: formData.get('latitude') ? parseFloat(formData.get('latitude') as string) : null,
      longitude: formData.get('longitude') ? parseFloat(formData.get('longitude') as string) : null,
      data_inicio: new Date(formData.get('data_inicio') as string).toISOString(),
      data_fim: formData.get('data_fim') ? new Date(formData.get('data_fim') as string).toISOString() : null,
      contacto_organizador: formData.get('contacto_organizador'),
      anunciante_nome: formData.get('anunciante_nome'),
      anunciante_email: formData.get('anunciante_email'),
      anunciante_telefone: formData.get('anunciante_telefone') || null,
      status: 'pendente',
      destaque: false
    };

    const { error } = await supabase.from('eventos').insert([novoEvento]);

    if (error) {
      msgErro!.innerText = 'Erro ao submeter o evento: ' + error.message;
      msgErro?.classList.remove('hidden');
      btnSubmit.disabled = false;
      btnSubmit.innerText = 'Submeter Evento para Moderação';
    } else {
      form.reset();
      form.classList.add('hidden');
      msgSucesso?.classList.remove('hidden');
    }
  });
</script>
